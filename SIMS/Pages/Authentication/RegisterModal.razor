@namespace SIMS.Pages.Authentication

@if (IsVisible)
{
    <div class="register-modal">
        <div class="register-container">
            <button class="close-button" @onclick="CloseModal">
                <span>&times;</span>
            </button>
            <div class="register-form">
                <h2 class="text-primary text-center">Register</h2>
                <form>
                    <div class="form-group">
                        <label for="fullName">Full name</label>
                        <input type="text" class="form-control" id="fullName" placeholder="Enter your full name...">
                    </div>
                    <div class="form-group">
                        <label for="phoneNumber">Phone number</label>
                        <input type="tel" class="form-control" id="phoneNumber" placeholder="Enter your phone number...">
                    </div>
                    <div class="form-group">
                        <label for="birthdate">Birthdate</label>
                        <input type="date" class="form-control" id="birthdate">
                    </div>
                    <div class="form-group">
                        <label for="major">Major</label>
                        <select class="form-control" id="major">
                            <option>Choose a major...</option>
                            <option>Software Engineering</option>
                            <option>Graphic Design</option>
                            <option>Business Administration</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">Register</button>
                </form>
            </div>
            <div class="register-logo">
                <img src="/mainLogo.jpeg" alt="Kupokatri Logo" class="img-fluid">
            </div>
        </div>
    </div>
}
@code {
    [Parameter]
    public bool IsVisible { get; set; }

    [Parameter]
    public EventCallback<bool> IsVisibleChanged { get; set; }

    private void CloseModal()
    {
        IsVisible = false;
        IsVisibleChanged.InvokeAsync(IsVisible);
    }
}
